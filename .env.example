# Application
NODE_ENV=development
PORT=3000

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-key
JWT_LIFETIME_SECONDS=3600

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# Must match the API version the installed `stripe` package's types expect
STRIPE_API_VERSION=2026-02-25.clover

# Cloudflare R2 Storage
R2_ENDPOINT_URL=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-url.com

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Chat (OpenRouter, optional)
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-3.5-sonnet
AI_MAX_TOKENS=2048

# Fiscal Nacional - Brazilian tax info & NFS-e (optional)
# Leave FISCAL_ENABLED=false to run billing/Stripe with no fiscal setup at all.
FISCAL_ENABLED=false
FISCAL_WEBHOOK_SECRET=

# Sentry (optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
